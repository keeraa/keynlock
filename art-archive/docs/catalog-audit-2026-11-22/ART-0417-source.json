{"info": {"total": 1, "parameters": {"skip": 0, "limit": 1000, "accession_number": "1997.91", "select": "accession_number,accession_number_sortable,cover_accession_number,department,department,classification_type,collection,gallery"}}, "data": [{"id": 160133, "accession_number": "1997.91", "share_license_status": "CC0", "tombstone": "Quails and Sparrows in an Autumn Scene (秋景鶉雀圖), 1347. Wang Yuan (Chinese, c. 1299–after 1366). Hanging scroll, ink on paper; painting: 114.3 x 56 cm (45 x 22 1/16 in.); overall with knobs: 267.5 x 85 cm (105 5/16 x 33 7/16 in.). The Cleveland Museum of Art, Bequest of Mrs. A. Dean Perry, 1997.91", "current_location": null, "title": "Quails and Sparrows in an Autumn Scene", "title_in_original_language": "秋景鶉雀圖", "creation_date": "1347", "creation_date_earliest": 1347, "creation_date_latest": 1347, "artists_tags": ["male"], "culture": ["China, Yuan dynasty (1271–1368)"], "technique": "hanging scroll, ink on paper", "support_materials": [], "department": "Chinese Art", "collection": "ASIAN - Hanging scroll", "type": "Painting", "measurements": "Painting: 114.3 x 56 cm (45 x 22 1/16 in.); Overall with knobs: 267.5 x 85 cm (105 5/16 x 33 7/16 in.)", "dimensions": {"painting": {"height": 1.143, "height_inch": 45, "height_inch_fraction": 0.0, "width": 0.56, "width_inch": 22, "width_inch_fraction": 0.0625}, "overall": {"height": 2.675, "height_inch": 105, "height_inch_fraction": 0.3125, "width": 0.745, "width_inch": 29, "width_inch_fraction": 0.3125}, "overall with knobs": {"height": 2.675, "height_inch": 105, "height_inch_fraction": 0.3125, "width": 0.85, "width_inch": 33, "width_inch_fraction": 0.4375}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [{"inscription": "至正丁亥春 錢塘王淵若水寫秋景鶉雀圖\n[印] 澹轩; [印] 若水; [印] 墨妙筆精", "inscription_translation": "Artist's inscription, signature, and 3 seals: In the year of Zhizheng, spring of dinghai [1347], Wang Yuan, Ruoshui of Qiantang, drew this picture of Quails and Sparrows in an Autumn Scene. \n[seals] Danxuan; Ruoshuii; Mo miao bi jing.", "inscription_remark": null, "sortorder": 1}, {"inscription": "翦翦輕風搖翠葆，團團清露滴金叢。\n劍南畫手今何在，冷落賓榔枸杞新。\n鐵篴\n[印] 杨维桢印; [印] 廉夫", "inscription_translation": "1 poem and 2 seals of Yang Weizhen (1296–1370): \n\nHow lovely is the light breeze that stirs the verdant foliage. \nLike pearls the fresh dew drips over the golden groves. \nWhere is the painter now, who hailed from Jian’nan? \nLike the leftover betel nut, it is being replaced with fresh goji berry.\n\nTiedi.\n[Seals] Yang Weizhen yin; Lianfu", "inscription_remark": null, "sortorder": 2}, {"inscription": "1 inscription and 10 seals of the Qianlong emperor (r. 1736–95)", "inscription_translation": null, "inscription_remark": null, "sortorder": 3}, {"inscription": "4 seals of Zhang Heng 張珩 (1915–1963)", "inscription_translation": null, "inscription_remark": null, "sortorder": 4}], "exhibitions": {"current": [{"id": 377849, "title": "1000 Jahre Chinesische Malerei", "description": "<i>1000 Jahre Chinesische Malerei</i>. Haus der Kunst, Munich, Mùnich, Germany (organizer) (October 16-December 13, 1959).", "opening_date": "1959-10-16T04:00:00"}, {"id": 301272, "title": "Chinese Art Under the Mongols: The Yuan Dynasty (1279–1368)", "description": "<i>Chinese Art Under the Mongols: The Yuan Dynasty (1279–1368)</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (October 2-November 24, 1968).", "opening_date": "1968-10-02T04:00:00"}, {"id": 539332, "title": "Six Dynasties of Chinese Painting (Chinese art rotation)", "description": "<i>Six Dynasties of Chinese Painting (Chinese art rotation)</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (November 10, 2023-May 5, 2024).", "opening_date": "2023-11-10T05:00:00"}], "legacy": [{"description": "<em>Chiao-yü-pu</em>. [Jiao yu bu di er ci quan guo mei shu zhan lan hui zhuan ji 敎育部第二次全國美術展覽會專集 = A special collection of the second National Exhibition of Chinese Art under the auspices of the Ministry of Education]. Nanking Art Gallery, Nanjing, China (April 1-23, 1937).", "opening_date": "1937-04-01T05:00:00Z"}, {"description": "<em>An exhibition of authenticated Chinese paintings.</em>C. T Loo &amp; Co., New York, NY (April 1948).", "opening_date": "1948-04-01T05:00:00Z"}, {"description": "<em>Masterpieces of Chinese Bird and Flower Painting</em>. Fogg Art Museum, Cambridge, MA (October 30-December 14, 1951).", "opening_date": "1951-10-30T05:00:00Z"}, {"description": "<em>Loan exhibition of Chinese paintings</em>. Royal Ontario Museum, Toronto, Ontario, Canada (May-June 1956).", "opening_date": "1956-05-01T04:00:00Z"}, {"description": "<em>Eight Dynasties of Chinese Painting</em>. The Nelson-Atkins Museum of Art (November 7, 1980-January 4, 1981); The Cleveland Museum of Art (February 10-March 29, 1981); Tokyo National Museum (October 4-November 17, 1982).", "opening_date": "1980-11-07T05:00:00Z"}, {"description": "<em>Main Asian Rotation (Gallery 242)</em>. The Cleveland Museum of Art, Cleveland, OH (July 28, 2014-January 7, 2015).", "opening_date": "2014-07-28T04:00:00Z"}]}, "provenance": [{"description": "Qing imperial collection [seals of Emperor Qianlong, r. 1736–95]", "citations": [], "footnotes": [], "date": null, "sortorder": 1}, {"description": "Zhang Heng 張珩 [1915–1963]", "citations": [], "footnotes": [], "date": null, "sortorder": 2}, {"description": "(Frank Caro [1904–1980], New York, NY, sold to Mr. and Mrs. A. Dean Perry)", "citations": [], "footnotes": [], "date": "?-1960", "sortorder": 3}, {"description": "Mr. A. Dean and Mrs. Helen Wade Greene Perry [1911-1996], Cleveland, OH, bequest to the Cleveland Museum of Art", "citations": [], "footnotes": [], "date": "1960-1997", "sortorder": 4}, {"description": "The Cleveland Museum of Art, Cleveland, OH", "citations": [], "footnotes": [], "date": "1997-", "sortorder": 5}], "find_spot": null, "related_works": [], "former_accession_numbers": ["121.81"], "did_you_know": "Wang Yuan was from Qiantang, today’s Hangzhou in eastern China.", "early_education_description": null, "artlens_description": null, "description": "The flower-and-bird subjects here are depicted in a meticulous manner, echoing the academic tradition but translating the customarily colored images to plain monochrome. Fine ink lines combined with carefully graded washes define the contours and give subtle modeling to the natural forms. <br><br>Wang Yuan excelled in flower-and-bird subjects as well as landscape and figure paintings. A child prodigy, he was instructed by the great Yuan master Zhao Mengfu at an early age.", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q60477504"], "internet_archive": ["https://archive.org/details/clevelandart-1997.91-quails-and-sparrows"]}, "citations": [{"citation": "<em>Jiao yu bu di er ci quan guo mei shu zhan lan hui zhuan ji</em> [敎育部第二次全國美術展覽會專集 = A special collection of the second National Exhibition of Chinese Art under the auspices of the Ministry of Education]. [Nanjing?]: Shang wu yin shu guan, 1937.", "page_number": "vol. 1, cat. no. 68", "url": null}, {"citation": "Wang, Chi-ch'ien 王季遷. <em>An Exhibition of Authenticated Chinese Paintings, April 1948</em>. New York: C.T. Loo, 1948.", "page_number": "cat. no. 8", "url": null}, {"citation": "Rowland, Benjamin. <em>Masterpieces of Chinese Bird and Flower Painting; A Loan Exhibition. October 30-December 14, 1951</em>. Cambridge, MA: Fogg Art Museum, 1951.", "page_number": "cat. no. 15", "url": null}, {"citation": "Caro, Frank and Hsien-Chi Tseng. <em>Loan Exhibition of Chinese Paintings</em>. Toronto: Royal Ontario Museum of Archaeology, 1956.", "page_number": "cat. no. 7", "url": null}, {"citation": "Goepper, Roger. <em>1000 Jahre chinesische Malerei</em>. München: Haus der Kunst, 1959.", "page_number": "cat. no. 32", "url": null}, {"citation": "Lee, Sherman E., and Wai-kam Ho. <em>Chinese Art Under the Mongols: The Yüan Dynasty, 1279-1368</em>. Cleveland, OH: The Cleveland Museum of Art; [distributed by the Press of Case Western Reserve University], 1968.", "page_number": "Mentioned and Reproduced: cat. no. 240", "url": null}, {"citation": "Ho, Wai-kam, Sherman E. Lee, Laurence Sickman, and Marc F. Wilson. <em>Eight Dynasties of Chinese Painting: The Collections of the Nelson Gallery-Atkins Museum, Kansas City, and the Cleveland Museum of Art</em>. Cleveland, OH: Cleveland Museum of Art, in cooperation with Indiana University Press, 1980.", "page_number": "Reproduced: pp. 107-108, cat. no. 87", "url": null}, {"citation": "Chou, Ju-hsi and Anita Chung. <em>Silent poetry: Chinese paintings from the collection of the Cleveland Museum of Art</em>. Cleveland, OH: The Cleveland Museum of Art, 2015.", "page_number": "Reproduced: pp. 150-153", "url": null}, {"citation": "Giuffrida, Noelle. <em>Separating Sheep from Goats: Sherman E. Lee and Chinese Art Collecting in Postwar America</em>. Oakland, California: University of California Press, 2018.", "page_number": "Mentioned: p. 125. Reproduced: fig. 73, p. 124", "url": null}, {"citation": "Giuffrida, Noelle. <em>Separating Sheep from Goats: Sherman E. Lee and Chinese Art Collecting in Postwar America</em>. Oakland, California: University of California Press, 2018.", "page_number": "Reproduced: p. 124, fig. 73", "url": null}], "url": "https://clevelandart.org/art/1997.91", "images": {"annotation": null, "web": {"url": "https://openaccess-cdn.clevelandart.org/1997.91/1997.91_web.jpg", "width": "492", "height": "900", "filesize": "154298", "filename": "1997.91_web.jpg"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/1997.91/1997.91_print.jpg", "width": "1860", "height": "3400", "filesize": "1751286", "filename": "1997.91_print.jpg"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/1997.91/1997.91_full.tif", "width": "10549", "height": "19283", "filesize": "610275088", "filename": "1997.91_full.tif"}}, "alternate_images": [{"web": {"url": "https://openaccess-cdn.clevelandart.or