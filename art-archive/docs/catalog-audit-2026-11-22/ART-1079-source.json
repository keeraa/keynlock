{"info": {"total": 1, "parameters": {"skip": 0, "limit": 1000, "accession_number": "1985.110", "select": "accession_number,accession_number_sortable,cover_accession_number,department,classification_type,collection,gallery,department"}}, "data": [{"id": 152184, "accession_number": "1985.110", "share_license_status": "CC0", "tombstone": "Water-Moon Kannon (水月観音図), c. 1500. Attributed to Gakuō Zōkyū (Japanese, active about 1482–1514). Hanging scroll; ink on paper; painting: 104.8 x 44 cm (41 1/4 x 17 5/16 in.); mounted: 207 x 62.5 cm (81 1/2 x 24 5/8 in.). The Cleveland Museum of Art, John L. Severance Fund, 1985.110", "current_location": null, "title": "Water-Moon Kannon", "title_in_original_language": "水月観音図", "creation_date": "c. 1500", "creation_date_earliest": 1490, "creation_date_latest": 1510, "artists_tags": ["male"], "culture": ["Japan, Muromachi period (1392–1573)"], "technique": "Hanging scroll; ink on paper", "support_materials": [], "department": "Japanese Art", "collection": "ASIAN - Hanging scroll", "type": "Painting", "measurements": "Painting: 104.8 x 44 cm (41 1/4 x 17 5/16 in.); Mounted: 207 x 62.5 cm (81 1/2 x 24 5/8 in.)", "dimensions": {"painting": {"height": 1.048, "height_inch": 41, "height_inch_fraction": 0.25, "width": 0.44, "width_inch": 17, "width_inch_fraction": 0.3125}, "mounted with knobs": {"height": 2.07, "height_inch": 81, "height_inch_fraction": 0.5, "width": 0.679, "width_inch": 26, "width_inch_fraction": 0.75}, "mounted": {"height": 2.07, "height_inch": 81, "height_inch_fraction": 0.5, "width": 0.625, "width_inch": 24, "width_inch_fraction": 0.625}, "cord": {"height": 0.03, "height_inch": 1, "height_inch_fraction": 0.1875}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [], "exhibitions": {"current": [{"id": 309910, "title": "The Year in Review for 1985", "description": "<i>The Year in Review for 1985</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (February 12-April 20, 1986)