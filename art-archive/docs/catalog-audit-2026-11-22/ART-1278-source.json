{"info": {"total": 1, "parameters": {"skip": 0, "limit": 1000, "accession_number": "2013.324", "select": "accession_number,accession_number_sortable,cover_accession_number,department,department,gallery,collection,classification_type"}}, "data": [{"id": 170834, "accession_number": "2013.324", "share_license_status": "CC0", "tombstone": "Portrait of Raja Jagat Singh of Nurpur (reigned 1618–46), probably 1619. Attributed to Bichitr (Indian, active c. 1615–50). Gum tempera and gold on paper; painting only: 19.1 x 11.6 cm (7 1/2 x 4 9/16 in.); page: 41 x 32.7 cm (16 1/8 x 12 7/8 in.). The Cleveland Museum of Art, Gift in honor of Madeline Neves Clapp; Gift of Mrs. Henry White Cannon by exchange; Bequest of Louise T. Cooper; Leonard C. Hanna Jr. Fund; From the Catherine and Ralph Benkaim Collection, 2013.324", "current_location": null, "title": "Portrait of Raja Jagat Singh of Nurpur (reigned 1618–46)", "creation_date": "probably 1619", "creation_date_earliest": 1618, "creation_date_latest": 1620, "artists_tags": ["male"], "culture": ["Mughal India, Court of Jahangir (reigned 1605 - 27), possibly Lahore"], "technique": "Gum tempera and gold on paper", "support_materials": [], "department": "Indian and Southeast Asian Art", "collection": "Indian Art - Mughal", "type": "Painting", "measurements": "Painting only: 19.1 x 11.6 cm (7 1/2 x 4 9/16 in.); Page: 41 x 32.7 cm (16 1/8 x 12 7/8 in.)", "dimensions": {"page": {"height": 0.41, "height_inch": 16, "height_inch_fraction": 0.125, "width": 0.327, "width_inch": 12, "width_inch_fraction": 0.875}, "painting only": {"height": 0.191, "height_inch": 7, "height_inch_fraction": 0.5, "width": 0.116, "width_inch": 4, "width_inch_fraction": 0.5625}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [{"inscription": "ascription in lower right corner: amal - i bandieh dargah Bichitr", "inscription_translation": null, "inscription_remark": null, "sortorder": null}], "exhibitions": {"current": [{"id": 308686, "title": "Indian Gallery 242 Rotation – April-November 2018", "description": "<i>Indian Gallery 242 Rotation – April-November 2018</i>. The Cleveland Museum of Art (organizer) (April 2-November 18, 2018).", "opening_date": "2018-04-02T04:00:00"}, {"id": 689135, "title": "Of the Hills: Paintings from India’s Himalayan Kingdoms", "description": "<i>Of the Hills: Paintings from India’s Himalayan Kingdoms</i>. National Museum of Asian Art, Washington, DC (organizer) (April 18-July 26, 2026) https://asia.si.edu/whats-on/exhibitions/of-the-hills/.", "opening_date": "2026-04-18T04:00:00"}], "legacy": []}, "provenance": [{"description": "Private collection, 1930–2005", "citations": [], "footnotes": null, "date": "1930–2005", "sortorder": 1}, {"description": "Catherine Glynn Benkaim and Barbara Timmer, Beverly Hills, CA, sold to the Cleveland Museum of Art", "citations": [], "footnotes": null, "date": "2005–2013", "sortorder": 2}, {"description": "The Cleveland Museum of Art, Cleveland, OH", "citations": [], "footnotes": null, "date": "2013–", "sortorder": 3}], "find_spot": null, "related_works": [], "former_accession_numbers": [], "did_you_know": "Jagat Singh, shown in this miniature, was a favorite of the Mughal queen.", "early_education_description": null, "artlens_description": null, "description": "Jagat Singh was a prince from a small kingdom in the western Himalayan foothills who grew up at the imperial Mughal court of Jahangir and his queen Nur Jahan. He was given the title of prince in 1619, and this painting may commemorate that event. Very few nobles from the hill states had positions at the Mughal court at this time, so his portrait is a rare imperial Mughal painting.<br><br>The emperor and his favorite wife frequently visited Nurpur, named “City of Light” in their honor, to hunt and relax, and Prince Jagat Singh was a favorite of the queen. She interceded on his behalf in 1624, when he joined a rebellion to dethrone her husband.", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q60481761"], "internet_archive": ["https://archive.org/details/clevelandart-2013.324-portrait-of-raja-jag"]}, "citations": [{"citation": "Mace, Sonya Rhie, Mohsen Ashtiany, Catherine Glynn, Pedro Moura Carvalho, Marcus Fraser, and Ruby Lal. <em>Mughal Paintings: Art and Stories: the Cleveland Museum of Art</em>. London: D Giles Limited, 2016.", "page_number": "Mentioned and Reproduced: cat. 53, pp. 332–333 and fig. no. 4.79, p. 228", "url": ""}], "url": "https://clevelandart.org/art/2013.324", "images": {"annotation": null, "web": {"url": "https://openaccess-cdn.clevelandart.org/2013.324/2013.324_web.jpg", "width": "615", "height": "900", "filesize": "278827", "filename": "2013.324_web.jpg"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/2013.324/2013.324_print.jpg", "width": "2324", "height": "3400", "filesize": "3678655", "filename": "2013.324_print.jpg"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/2013.324/2013.324_full.tif", "width": "4548", "height": "6653", "filesize": "90802594", "filename": "2013.324_full.tif"}}, "alternate_images": [{"web": {"url": "https://openaccess-cdn.clevelandart.org/2013.324/2013.324_alt0_web.jpg", "width": "724", "height": "900", "filesize": "223751"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/2013.324/2013.324_alt0_print.jpg", "width": "2736", "height": "3400", "filesize": "3868569"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/2013.324/2013.324_alt0_full.tif", "width": "9067", "height": "11266", "filesize": "306474658"}, "date_created": "2025-01-28T15:45:46", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/2013.324/2013.324_alt1_web.jpg", "width": "725", "height": "900", "filesize": "305318"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/2013.324/2013.324_alt1_print.jpg", "width": "2737", "height": "3400", "filesize": "4310024"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/2013.