{"info": {"total": 1, "parameters": {"skip": 0, "limit": 1000, "accession_number": "2015.467", "select": "accession_number,accession_number_sortable,cover_accession_number,department,department,classification_type,collection,gallery"}}, "data": [{"id": 79576, "accession_number": "2015.467", "share_license_status": "CC0", "tombstone": "Chinese Literatus in an Autumn Landscape, late 1400s. Josui Sōen (Japanese, active c. 1489–1500). Hanging scroll; ink on paper; mounted: 111 x 56.2 cm (43 11/16 x 22 1/8 in.). The Cleveland Museum of Art, Gift from the Collection of George Gund III, 2015.467", "current_location": null, "title": "Chinese Literatus in an Autumn Landscape", "creation_date": "late 1400s", "creation_date_earliest": 1475, "creation_date_latest": 1499, "artists_tags": ["male"], "culture": ["Japan, Muromachi period (1392–1573)"], "technique": "hanging scroll; ink on paper", "support_materials": [], "department": "Japanese Art", "collection": "ASIAN - Hanging scroll", "type": "Painting", "measurements": "Mounted: 111 x 56.2 cm (43 11/16 x 22 1/8 in.)", "dimensions": {"mounted": {"height": 1.11, "height_inch": 43, "height_inch_fraction": 0.6875, "width": 0.562, "width_inch": 22, "width_inch_fraction": 0.125}, "painting": {"height": 0.298, "height_inch": 11, "height_inch_fraction": 0.75, "width": 0.445, "width_inch": 17, "width_inch_fraction": 0.5}, "mounted with cord": {"height": 1.163, "height_inch": 45, "height_inch_fraction": 0.8125}, "mounted with knobs": {"width": 0.61, "width_inch": 24, "width_inch_fraction": 0.0}, "knob diam": {"height": 0.023, "height_inch": 0, "height_inch_fraction": 0.875}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [{"inscription": "Signed: \"Sō'en\" 宗淵. Sealed: \"Josui\" 如水; one seal unread.", "inscription_translation": null, "inscription_remark": null, "sortorder": 1}], "exhibitions": {"current": [{"id": 287723, "title": "Reeds and Geese: Japanese Art from the Collection of George Gund III", "description": "<i>Reeds and Geese: Japanese Art from the Collection of George Gund III</i>. The Cleveland Museum of Art, Cleveland, OH (organizer) (May 21-September 3, 2017).", "opening_date": "2017-05-21T04:00:00"}], "legacy": []}, "provenance": [{"description": "George Gund III [1937–2013], bequest to the Cleveland Museum of Art", "citations": [], "footnotes": null, "date": "?–2015", "sortorder": 1}, {"description": "The Cleveland Museum of Art, Cleveland, OH", "citations": [], "footnotes": null, "date": "2015–", "sortorder": 2}], "find_spot": null, "related_works": [], "former_accession_numbers": [], "did_you_know": null, "early_education_description": null, "artlens_description": null, "description": "In this painting, Sesshū Tōyō’s disciple Sōen depicts a Chinese scholar-official astride a donkey with his attendant behind. Framing their passage on the right side of the scene are two bare willows, and on the left, geese in flight, the cries of which capture the pair’s attention. These elements suggest that the season is late autumn. Sōen, who famously received Sesshū’s 1495 Splashed-ink Landscape as a certificate of his success as a pupil, studied with the master in Suō, presentday Yamaguchi, after which he returned to his native province in the Kanto region.", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q60493311"], "internet_archive": ["https://archive.org/details/clevelandart-2015.467-chinese-literatus-in"]}, "citations": [{"citation": "\"Exhibitions.” <em>Cleveland Art: Cleveland Museum of Art Members Magazine</em> 57, no. 4 (July/August 2017): 4–5.", "page_number": "Reproduced and Mentioned: p. 4", "url": "https://archive.org/details/CMAMM2017-04/page/n1/mode/2up"}], "url": "https://clevelandart.org/art/2015.467", "images": {"annotation": null, "web": {"url": "https://openaccess-cdn.clevelandart.org/2015.467/2015.467_web.jpg", "width": "900", "height": "606", "filesize": "182132", "filename": "2015.467_web.jpg"}, "print": {"u