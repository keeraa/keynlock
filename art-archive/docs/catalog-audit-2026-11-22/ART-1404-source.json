{"info": {"total": 1, "parameters": {"skip": 0, "limit": 1000, "accession_number": "2015.472", "select": "accession_number,accession_number_sortable,cover_accession_number,department,department,classification_type,collection,gallery"}}, "data": [{"id": 79581, "accession_number": "2015.472", "share_license_status": "CC0", "tombstone": "Bodhidharma (菩提達磨図), early to mid-1500s. Attributed to Unkei Eii (Japanese, active c. 1504–1555). Hanging scroll; ink on paper; painting: 56.6 x 25.9 cm (22 5/16 x 10 3/16 in.); mounted: 127.5 x 27.7 cm (50 3/16 x 10 7/8 in.). The Cleveland Museum of Art, Gift from the Collection of George Gund III, 2015.472", "current_location": null, "title": "Bodhidharma", "title_in_original_language": "菩提達磨図", "creation_date": "early to mid-1500s", "creation_date_earliest": 1504, "creation_date_latest": 1555, "artists_tags": ["male"], "culture": ["Japan, Muromachi period (1392–1573)"], "technique": "hanging scroll; ink on paper", "support_materials": [], "department": "Japanese Art", "collection": "ASIAN - Hanging scroll", "type": "Painting", "measurements": "Painting: 56.6 x 25.9 cm (22 5/16 x 10 3/16 in.); Mounted: 127.5 x 27.7 cm (50 3/16 x 10 7/8 in.)", "dimensions": {"mounted": {"height": 1.275, "height_inch": 50, "height_inch_fraction": 0.1875, "width": 0.277, "width_inch": 10, "width_inch_fraction": 0.875}, "painting": {"height": 0.566, "height_inch": 22, "height_inch_fraction": 0.3125, "width": 0.259, "width_inch": 10, "width_inch_fraction": 0.1875}}, "state_of_the_work": null, "edition_of_the_work": null, "copyright": null, "inscriptions": [{"inscription": "西天？？ 東土初祖/ 這野狐精謾誑梁主/ 春浦叟宗熙拝", "inscription_translation": "From Western Heaven [India] ??, the First Patriarch of the Eastern Land [Bodhidharma]. This fox-spirit confounded the Lord of Liang. Respectfully [offered by] the elder Shunpo Sōki.", "inscription_remark": "The two unread characters would typically refer to Bodhidharma as the 28th patriarch of the tradition. The inscription refers to Bodhidharma's encounter with Emperor Wu of Liang. The inscription is associated with Shunpo Sōki (1416–1496) of Daitokuji, and is either spurious or meant to attribute the content to Shunpo. It lacks the customary seals, and the calligraphy does not resemble that of Shunpo.", "sortorder": 1}, {"inscription": "款記　雲渓筆", "inscription_translation": null, "inscription_remark": null, "sortorder": 2}, {"inscription": "朱文方印　？", "inscription_translation": "unread seal", "inscription_remark": "This seal is distinct from the square seal reading Eii (永怡) found on a number of the painter's works.", "sortorder": 3}], "exhibitions": {"current": [], "legacy": []}, "provenance": [{"description": "George Gund III [1937–2013], bequest to the Cleveland Museum of Art", "citations": [], "footnotes": null, "date": "?–2015", "sortorder": 1}, {"description": "The Cleveland Museum of Art, Cleveland, OH", "citations": [], "footnotes": null, "date": "2015–", "sortorder": 2}], "find_spot": null, "related_works": [], "former_accession_numbers": [], "did_you_know": null, "early_education_description": null, "artlens_description": null, "description": "Chan (Japanese: Zen) Buddhism was introduced to China in the early 500s by Indian monk Bodhidharma (Japanese: Bodai Daruma; died before 534). It is said that upon his arrival in China, Bodhidharma was permitted to meet with Emperor Wu (reigned 502–49) of the Liang dynasty. Realizing the emperor did not understand his religious goals, the monk left and crossed the Yangzi River on a reed, settling in Henan Province’s Shaolin Monastery. This portrait of Bodhidharma is accompanied by an inscription that also refers to his encounter with Emperor Wu.", "external_resources": {"wikidata": ["https://www.wikidata.org/wiki/Q60493326"], "internet_archive": []}, "citations": [{"citation": "Cunningham, Michael R., Shinʼichi Miyajima, and Yūji Yamashita. <em>Ink Paintings and Ash-Glazed Ceramics: Medieval Calligraphy, Painting, and Ceramic Art from Japan and Korea</em>. Cleveland, OH: The Cleveland Museum of Art, 2000.", "page_number": "pp. 43–44", "url": null}], "url": "https://clevelandart.org/art/2015.472", "images": {"annotation": null, "web": {"url": "https://openaccess-cdn.clevelandart.org/2015.472/2015.472_web.jpg", "width": "453", "height": "900", "filesize": "134795", "filename": "2015.472_web.jpg"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/2015.472/2015.472_print.jpg", "width": "1711", "height": "3400", "filesize": "1734470", "filename": "2015.472_print.jpg"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/2015.472/2015.472_full.tif", "width": "6826", "height": "13563", "filesize": "277770120", "filename": "2015.472_full.tif"}}, "alternate_images": [{"web": {"url": "https://openaccess-cdn.clevelandart.org/2015.472/2015.472_alt0_web.jpg", "width": "471", "height": "900", "filesize": "129588"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/2015.472/2015.472_alt0_print.jpg", "width": "1778", "height": "3400", "filesize": "1590476"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/2015.472/2015.472_alt0_full.tif", "width": "6601", "height": "12625", "filesize": "250040344"}, "date_created": "2024-10-03T15:32:30", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/2015.472/2015.472_alt1_web.jpg", "width": "501", "height": "900", "filesize": "137154"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/2015.472/2015.472_alt1_print.jpg", "width": "1893", "height": "3400", "filesize": "1695941"}, "full": {"url": "https://openaccess-cdn.clevelandart.org/2015.472/2015.472_alt1_full.tif", "width": "6802", "height": "12214", "filesize": "249267092"}, "date_created": "2024-10-03T15:33:08", "annotation": ""}, {"web": {"url": "https://openaccess-cdn.clevelandart.org/2015.472/2015.472_alt2_web.jpg", "width": "890", "height": "900", "filesize": "188767"}, "print": {"url": "https://openaccess-cdn.clevelandart.org/2015.472/2015.472_alt2_print.jpg", 