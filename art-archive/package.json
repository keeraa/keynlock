{
  "name": "keynlock-art-archive",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "node scripts/dev.mjs",
    "preview": "node serve.mjs",
    "build:hosted": "node scripts/build-hosted.mjs",
    "check": "npm test && npm run build",
    "release": "node scripts/prepare-release.mjs",
    "report:playtest": "node scripts/playtest-report.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
