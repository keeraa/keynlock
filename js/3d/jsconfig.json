{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "scenes/lair/src",
    "workshops/*/src",
    "core",
    "scenes/key-archive/dist/js"
  ]
}
